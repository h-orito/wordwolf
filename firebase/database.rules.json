{
  "rules": {
    ".read": false,
    ".write": false,
    "messages": {
      ".read": true,
      "$roomKey": {
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name', 'key', 'message', 'createdAt']) && (newData.child('name').val() === '' || newData.child('memberKey').val() === auth.uid)",
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "key": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "message": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 3000" },
          "color": { ".validate": "newData.isString() && newData.val().matches(/^color(0[1-9]|10)$/)" },
          "memberKey": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "clientToken": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "$other": { ".validate": false }
        }
      }
    },
    "votes": {
      ".read": true,
      "$roomKey": {
        ".write": "auth != null && !newData.exists()",
        "$voteId": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['uid', 'target', 'createdAt'])",
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
